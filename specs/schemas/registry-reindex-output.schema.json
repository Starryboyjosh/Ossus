{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ossus.dev/schemas/registry-reindex-output-1.0.0.json",
  "title": "Ossus Registry Reindex Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "index_schema_version", "indexed", "excluded",
    "catalog_fingerprint"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "index_schema_version": { "const": 1 },
    "indexed": { "type": "integer", "minimum": 0 },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "diagnostics"],
        "properties": {
          "path": { "type": "string" },
          "diagnostics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["class", "severity", "reason_code", "field_path", "message"],
              "properties": {
                "class": { "enum": ["schema", "taxonomy"] },
                "severity": { "enum": ["error", "warning"] },
                "reason_code": { "type": "string" },
                "field_path": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "catalog_fingerprint": { "type": "string", "pattern": "^fnv1a64:[0-9a-f]{16}$" }
  }
}
