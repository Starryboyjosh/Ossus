{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ossus.dev/schemas/registry-search-output-1.0.0.json",
  "title": "Ossus Registry Search Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "results", "limit", "offset"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "results": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/resource" }
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
    "offset": { "type": "integer", "minimum": 0, "maximum": 100000 }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "description", "resource_type", "source_mode",
        "source_repository", "source_commit", "source_subpath", "tree_hash",
        "capabilities", "categories", "surfaces", "runtimes", "risk_tier",
        "review_status", "distribution_mode"
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "resource_type": { "type": "string" },
        "source_mode": { "type": "string" },
        "source_repository": { "type": "string" },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "source_subpath": { "type": ["string", "null"] },
        "tree_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "categories": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "surfaces": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "runtimes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "risk_tier": { "enum": ["R0", "R1", "R2", "R3", "R4", "R5"] },
        "review_status": { "type": "string" },
        "distribution_mode": { "type": "string" }
      }
    }
  }
}
