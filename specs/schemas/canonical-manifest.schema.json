{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ossus.dev/schemas/canonical-manifest-1.0.0.json",
  "title": "Ossus Canonical Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_schema",
    "id",
    "resource_type",
    "source",
    "capabilities",
    "categories",
    "compatibility",
    "runtime",
    "risk",
    "review",
    "distribution"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "capability_schema": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "resource_type": {
      "enum": [
        "skill",
        "prompt-pack",
        "mcp-server"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "repository",
        "commit",
        "tree_hash"
      ],
      "properties": {
        "mode": {
          "enum": [
            "remote-index",
            "vendored",
            "local-private"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "subpath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000]+$"
        },
        "tree_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "license": {
          "type": "string",
          "maxLength": 128
        }
      },
      "if": {
        "properties": {
          "mode": {
            "not": {
              "const": "local-private"
            }
          }
        }
      },
      "then": {
        "required": [
          "license"
        ]
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "optional": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "triggers": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80
      }
    },
    "exclusions": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 120
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaces",
        "portability",
        "scopes"
      ],
      "properties": {
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 64,
            "enum": [
              "agent-skills-standard",
              "claude-code-cli",
              "claude-agent-sdk",
              "claude-api-host",
              "codex-cli",
              "codex-ide",
              "generic-terminal-agent",
              "generic-mcp-client",
              "standalone-cli"
            ]
          }
        },
        "portability": {
          "enum": [
            "portable-standard",
            "portable-with-adapter",
            "host-extension",
            "host-exclusive",
            "unknown"
          ]
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "project",
              "user-global",
              "plugin",
              "custom-path",
              "remote-only"
            ]
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements"
      ],
      "properties": {
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "enum": [
              "instruction-only",
              "filesystem-only",
              "shell-required",
              "network-required",
              "mcp-required",
              "external-cli-required",
              "host-api-required"
            ]
          }
        },
        "external_tools": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier"
      ],
      "properties": {
        "tier": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3",
            "R4",
            "R5"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "tier",
        "approved_commit",
        "reviewer_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "approved",
            "deprecated",
            "revoked"
          ]
        },
        "tier": {
          "description": "Schema-v1 legacy review-depth wire label. The serialized values remain stable for compatibility; they describe focused, complete, or security-agent review depth rather than reviewer identity.",
          "enum": [
            "light-human",
            "full-human",
            "security-human"
          ]
        },
        "approved_commit": {
          "type": "string",
          "minLength": 7,
          "maxLength": 64
        },
        "reviewer_ids": {
          "description": "Identifiers for the agent reviewers or review runs that supplied review evidence. Schema v1 preserves this field name and does not encode reviewer species or authority.",
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "measured_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "measurement_method": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "source-only",
            "approved-install-only",
            "vendored-redistributable"
          ]
        },
        "notice_required": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "mode": {
                "const": "remote-index"
              }
            }
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "distribution": {
            "properties": {
              "mode": {
                "enum": [
                  "source-only",
                  "approved-install-only"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "mode": {
                "const": "vendored"
              }
            }
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "distribution": {
            "properties": {
              "mode": {
                "enum": [
                  "approved-install-only",
                  "vendored-redistributable"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "mode": {
                "const": "local-private"
              }
            }
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "distribution": {
            "properties": {
              "mode": {
                "enum": [
                  "source-only",
                  "approved-install-only"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
